{
  "name": "plus11-learning",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "python3 scripts/supervise.py",
    "build": "next build",
    "start": "python3 scripts/supervise.py --production",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "setup:python": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
    "api:compile": ".venv/bin/python -m compileall -q src",
    "api:test": ".venv/bin/python -m pytest tests/",
    "api:migrate": ".venv/bin/python -m src.core.migrate",
    "db:migrate": ".venv/bin/python -m src.core.migrate"
  },
  "dependencies": {
    "framer-motion": "14.6.0",
    "jose": "6.2.13",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "6.0.3"
  }
}
